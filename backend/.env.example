DB_SERVER=localhost
DB_NAME=BookstoreDB
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_ENCRYPT=false
DB_TRUST_CERT=true
# DB_PORT=1433
PORT=3000
ORDER_AUTO_CANCEL_DAYS=3
ORDER_AUTO_CANCEL_CHECK_MINUTES=60
# NO_OPEN=1

# Runtime mode. In production, bootstrap passwords below are required if SystemUser is empty.
NODE_ENV=development
# BOOTSTRAP_ADMIN_PASSWORD=change_this_admin_password
# BOOTSTRAP_STAFF_PASSWORD=change_this_staff_password
# BOOTSTRAP_DELIVERY_PASSWORD=change_this_delivery_password
